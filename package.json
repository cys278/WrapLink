{
  "name": "wraplink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cluster.js",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "autocannon -c 100 -d 15 -p 10 http://localhost:3000/health",
    "db:migrate": "tsx src/database/migrate.ts",
    "start:single": "node dist/src/server.js",
    "dev:cluster": "node --env-file=.env --watch --import tsx src/cluster.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
