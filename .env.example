HOST=0.0.0.0
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Set to true behind a load balancer so rate limits use the client's IP.
TRUST_PROXY=false
MAX_LINKS=100000

DATABASE_URL=postgresql://shortener:shortener@127.0.0.1:55432/shortener
# Per worker. Total connections = WEB_CONCURRENCY x DATABASE_POOL_MAX.
DATABASE_POOL_MAX=20
# Worker processes (defaults to the number of CPU cores).
# WEB_CONCURRENCY=8

REDIS_URL=redis://127.0.0.1:6379
# Redis Cluster root nodes; when set, REDIS_URL is ignored.
# REDIS_CLUSTER_URLS=redis://127.0.0.1:7001,redis://127.0.0.1:7002,redis://127.0.0.1:7003
REDIS_CLUSTER_USE_REPLICAS=false
REDIS_CACHE_TTL_SECONDS=300

CREATE_RATE_LIMIT_MAX=20
CREATE_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separate multiple keys. Each key must contain at least 32 characters.
# Generate one with: openssl rand -hex 32
CREATE_API_KEYS=replace-with-a-random-key-of-at-least-32-characters

CLICK_FLUSH_INTERVAL_MS=1000
CLICK_BUFFER_MAX=10000

# "sync" (default) or "write-behind". See docs/ARCHITECTURE.md.
LINK_WRITE_MODE=sync
# Required for write-behind: 32+ characters, and NEVER change it once links
# exist. Generate with: openssl rand -hex 32
CODE_SCRAMBLE_SECRET=
WRITE_BEHIND_MAX_PENDING=1000000
# Defaults to true in write-behind mode.
# LINK_SYNC_ENABLED=true
LINK_SYNC_INTERVAL_MS=250
LINK_SYNC_BATCH_SIZE=1000
