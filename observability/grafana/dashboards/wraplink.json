{
  "title": "WrapLink",
  "uid": "wraplink",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "wraplink"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status_code) (rate(shortener_http_requests_total[1m]))",
          "legendFormat": "{{route}} {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency percentiles (all routes)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(shortener_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(shortener_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Redirects, misses and creations",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(shortener_redirects_total[1m])",
          "legendFormat": "redirects/s"
        },
        {
          "refId": "B",
          "expr": "rate(shortener_redirect_misses_total[1m])",
          "legendFormat": "misses/s"
        },
        {
          "refId": "C",
          "expr": "rate(shortener_links_created_total[1m])",
          "legendFormat": "created/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Write-behind pipeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(shortener_links_queued_total[1m])",
          "legendFormat": "queued/s"
        },
        {
          "refId": "B",
          "expr": "rate(shortener_links_synced_total[1m])",
          "legendFormat": "synced/s"
        },
        {
          "refId": "C",
          "expr": "rate(shortener_write_behind_backpressure_total[1m])",
          "legendFormat": "backpressure fallbacks/s"
        },
        {
          "refId": "D",
          "expr": "rate(shortener_write_behind_fallbacks_total[1m])",
          "legendFormat": "Redis fallbacks/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Links waiting for PostgreSQL",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shortener_link_sync_backlog",
          "legendFormat": "backlog"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sync problems",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(shortener_link_sync_conflicts_total[5m])",
          "legendFormat": "conflicts"
        },
        {
          "refId": "B",
          "expr": "increase(shortener_link_sync_errors_total[5m])",
          "legendFormat": "errors"
        },
        {
          "refId": "C",
          "expr": "increase(shortener_link_sync_poison_total[5m])",
          "legendFormat": "invalid records"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Clicks buffered in memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shortener_click_buffer_pending)",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "expr": "sum(shortener_click_buffer_dropped)",
          "legendFormat": "dropped"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Links stored (estimate)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "shortener_links_estimated",
          "legendFormat": "links"
        }
      ]
    }
  ]
}