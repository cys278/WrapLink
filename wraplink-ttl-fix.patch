From e4b44eb937b7fa77281d9ffed9eed9e796e0c66e Mon Sep 17 00:00:00 2001
From: WrapLink Developer <dev@wraplink.local>
Date: Sat, 31 Oct 2026 22:20:11 +0000
Subject: [PATCH] fix: use relative TTL for write-behind expiry to tolerate
 clock skew

---
 src/store/write-behind-link-store.ts | 11 +++++++++--
 test/write-behind-link-store.test.ts | 10 ++++++----
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/store/write-behind-link-store.ts b/src/store/write-behind-link-store.ts
index ebf8f8f..dd9c7be 100644
--- a/src/store/write-behind-link-store.ts
+++ b/src/store/write-behind-link-store.ts
@@ -40,7 +40,7 @@ const ENQUEUE_LINK = `
   )
 
   if ARGV[7] ~= "0" then
-    redis.call("PEXPIREAT", KEYS[1], ARGV[7])
+    redis.call("PEXPIRE", KEYS[1], ARGV[7])
   end
 
   redis.call("RPUSH", KEYS[2], ARGV[2])
@@ -209,8 +209,15 @@ export class WriteBehindLinkStore
             input.targetUrl,
             createdAt.toISOString(),
             input.expiresAt?.toISOString() ?? "",
+            // Relative, not absolute (PEXPIREAT): the app's and Redis's
+            // clocks may differ, and a relative TTL is immune to that skew.
             input.expiresAt
-              ? String(input.expiresAt.getTime())
+              ? String(
+                  Math.max(
+                    1,
+                    input.expiresAt.getTime() - createdAt.getTime(),
+                  ),
+                )
               : "0",
           ],
         },
diff --git a/test/write-behind-link-store.test.ts b/test/write-behind-link-store.test.ts
index 427e6b6..ab32a21 100644
--- a/test/write-behind-link-store.test.ts
+++ b/test/write-behind-link-store.test.ts
@@ -104,7 +104,7 @@ describe("WriteBehindLinkStore", () => {
     expect(evalOptions.arguments[6]).toBe("0");
   });
 
-  it("passes the absolute expiry to Redis", async () => {
+  it("passes the remaining lifetime to Redis as a relative TTL", async () => {
     const redis = fakeRedis();
     const store = new WriteBehindLinkStore(
       new MemoryLinkStore(10),
@@ -122,9 +122,11 @@ describe("WriteBehindLinkStore", () => {
     ];
 
     expect(evalOptions.arguments[5]).toBe(expiresAt.toISOString());
-    expect(evalOptions.arguments[6]).toBe(
-      String(expiresAt.getTime()),
-    );
+
+    const ttlMs = Number(evalOptions.arguments[6]);
+
+    expect(ttlMs).toBeGreaterThan(59_000);
+    expect(ttlMs).toBeLessThanOrEqual(60_000);
   });
 
   it("reports an existing code so the caller can retry", async () => {
-- 
2.43.0

